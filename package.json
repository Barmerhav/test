{
  "name": "pinui",
  "private": true,
  "version": "0.1.0",
  "description": "Two-sided trash-valet marketplace MVP (resident subscriptions + picker gig pickups). Hebrew-first, RTL, config-driven everything.",
  "scripts": {
    "gen:config-seed": "tsx scripts/gen-config-seed.ts",
    "gen:types": "bash scripts/gen-types.sh",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "test": "pnpm test:unit && pnpm test:db",
    "test:unit": "pnpm --filter @pinui/shared test",
    "test:db": "vitest run --config supabase/tests/vitest.config.ts",
    "e2e:demo": "tsx scripts/e2e-demo.ts",
    "admin:dev": "pnpm --filter admin dev",
    "app:start": "pnpm --filter app start"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.49.0",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.0",
    "supabase": "^2.30.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.24.1"
  },
  "packageManager": "pnpm@10.33.0"
}
